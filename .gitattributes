# 统一换行：仓库内一律用 LF，避免 Windows 检出成 CRLF 后
# 把 .sh 脚本弄坏（远端会报 `$'\r': command not found`）。
* text=auto eol=lf

# 明确标记为文本的文件
*.go    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf
*.css   text eol=lf

# 二进制文件不得做换行转换
*.exe   binary
*.db    binary
*.gz    binary
*.zip   binary
*.png   binary
*.jpg   binary
*.ico   binary

# 语言统计时把生成/第三方目录排除掉
openroute/frontend/package-lock.json  linguist-generated=true
openroute/docs/openapi.yaml           linguist-generated=true
